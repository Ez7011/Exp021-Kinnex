# in this file I want to show some possible ways to analyse the differential expression once i collapses all the read to their transncripts onl ytaking account of the structural category/trasncript id/gene
# i downloaded everything to my computer this is from df_clean - removed all the pval = NA or 1


df_clean <- read.csv("df_clean.csv", sep = ",", stringsAsFactors = FALSE, header = FALSE)

# if structural, transcript genes are all the same then collapse the counts and put all the ids together
df_collapsed <- df_clean %>%
  group_by(across(8:10)) %>%           
  summarise(
    across(V2:V7, ~ sum(as.numeric(.), na.rm = TRUE)),  
    ids = paste(.data$V1, collapse = ","),              
    .groups = "drop"
  )


head(df_collapsed)
